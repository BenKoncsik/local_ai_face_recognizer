---
import Layout from '../../layouts/Layout.astro';
import FaceOverlay from '../../components/FaceOverlay.astro';
import ObjectOverlay from '../../components/ObjectOverlay.astro';
import { loadPhotos, type Photo } from '../../lib/data';
import { link } from '../../lib/links';

export function getStaticPaths() {
  const photos = loadPhotos();
  return photos.map((photo, i) => ({
    params: { id: photo.id },
    props: {
      photo,
      prevId: i > 0 ? photos[i - 1].id : null,
      nextId: i < photos.length - 1 ? photos[i + 1].id : null,
      index: i + 1,
      total: photos.length,
    },
  }));
}

interface Props { photo: Photo; prevId: string | null; nextId: string | null; index: number; total: number; }
const { photo, prevId, nextId, index, total } = Astro.props;

// Unique named persons in this photo, with links to their detail pages.
const people = Array.from(
  new Map(
    photo.faces
      .filter((f) => f.person_id != null && f.name)
      .map((f) => [f.person_id, { id: f.person_id as number, name: f.name }])
  ).values()
);

// Tagged objects in this photo (separate domain from faces). Optional key on
// older bundles → default to []. Deduplicate the list by object id for the
// summary section while keeping every occurrence for the on-image overlay.
const objects = photo.objects ?? [];
const objectList = Array.from(
  new Map(objects.map((o) => [o.object_id, o])).values()
);
const hasPair = !!photo.pair;
// Full comparison group: B&W original + colorized variants. Three or more
// members enable the left/right pickers; exactly two keep the simple slider.
const members = photo.compare ?? [];
const hasMulti = members.length >= 3;
const bwIndex = members.findIndex((m) => m.isBw);
const firstColorIndex = members.findIndex((m) => !m.isBw);
const defLeft = bwIndex >= 0 ? bwIndex : 0;
const defRight = firstColorIndex >= 0 ? firstColorIndex : Math.min(1, members.length - 1);
const memberLabel = (m: { isBw: boolean; label: string }) =>
  m.isBw ? 'Fekete-fehér' : m.label ? `Színes ${m.label}` : 'Színes';
---
<Layout title={photo.fileName} active="photos">
  <div class="topbar">
    <a class="back" href={link('/photos/page/1/')}>‹ Galéria</a>
    <span class="muted">{index} / {total}</span>
    <span class="nav">
      {prevId ? <a href={link(`/photos/${prevId}/`)} rel="prev">‹ Előző</a> : <span class="disabled">‹ Előző</span>}
      {nextId ? <a href={link(`/photos/${nextId}/`)} rel="next">Következő ›</a> : <span class="disabled">Következő ›</span>}
    </span>
  </div>

  <div
    id="stage"
    class="stage"
    style={`aspect-ratio:${photo.mediumW || photo.width} / ${photo.mediumH || photo.height}`}
  >
    <img id="base-img" src={photo.medium} alt={photo.fileName} width={photo.mediumW || undefined} height={photo.mediumH || undefined} decoding="async" />
    {hasPair && <img id="top-img" alt="" aria-hidden="true" />}
    <FaceOverlay faces={photo.faces} />
    <ObjectOverlay objects={objects} />
    {/* Hidden sources for the colour/B&W pair. Their src attributes are
        rewritten to page-relative paths by astro-relative-links, so JS can read
        the resolved .src and the compare works from file:// too. */}
    {hasPair && <img id="pair-color" src={photo.pair!.color} hidden aria-hidden="true" alt="" />}
    {hasPair && <img id="pair-bw" src={photo.pair!.bw} hidden aria-hidden="true" alt="" />}
    {hasMulti && members.map((m, i) => (
      <img class="cmp-src" data-i={i} src={m.src} hidden aria-hidden="true" alt="" />
    ))}
    {hasPair && (
      <div id="cmp-slider" aria-hidden="true">
        <div class="line"></div><div class="handle">⇔</div>
      </div>
    )}
  </div>

  {hasPair && (
    <div class="pair-controls">
      <button data-mode="color" class="pc active" type="button">Színes</button>
      <button data-mode="bw" class="pc" type="button">Fekete-fehér</button>
      <button data-mode="compare" class="pc" type="button">Összehasonlítás</button>
    </div>
  )}

  {hasMulti && (
    <div id="cmp-pick" class="pair-pick">
      <label>Bal:
        <select id="cmp-left">
          {members.map((m, i) => <option value={i} selected={i === defLeft}>{memberLabel(m)}</option>)}
        </select>
      </label>
      <label>Jobb:
        <select id="cmp-right">
          {members.map((m, i) => <option value={i} selected={i === defRight}>{memberLabel(m)}</option>)}
        </select>
      </label>
    </div>
  )}

  <div class="info">
    <div class="facts">
      {photo.folder && <span><b>Mappa:</b> {photo.folder}</span>}
      {photo.date && <span><b>Dátum:</b> {photo.date}</span>}
      <span><b>Méret:</b> {photo.width}×{photo.height}</span>
    </div>
    <a class="orig-link" href={photo.original} target="_blank" rel="noopener">Eredeti kép megnyitása ↗</a>
  </div>

  {people.length > 0 && (
    <section class="people">
      <h2>Személyek a képen</h2>
      <ul>
        {people.map((p) => <li><a href={link(`/persons/${p.id}/`)}>{p.name}</a></li>)}
      </ul>
    </section>
  )}

  {objectList.length > 0 && (
    <section class="objects">
      <h2>Objektumok a képen</h2>
      <ul>
        {objectList.map((o) => (
          <li>
            <a class="obj-chip" href={link(`/objects/${o.object_id}/`)} title={o.note || undefined}>
              <span class="obj-name">{o.name || 'Névtelen objektum'}</span>
              {o.note && <span class="obj-note">{o.note}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <style>
    .topbar { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; flex-wrap: wrap; }
    .back { color: #88aaff; text-decoration: none; }
    .topbar .nav { margin-left: auto; display: flex; gap: 8px; }
    .topbar .nav a { color: #dbe6ff; text-decoration: none; border: 1px solid #3e5f9c; border-radius: 6px; padding: 5px 10px; background: #1d2b45; }
    .topbar .nav a:hover { border-color: #88aaff; }
    .topbar .nav .disabled, .muted { color: #777; }
    .topbar .nav .disabled { border: 1px solid #2a2a2a; border-radius: 6px; padding: 5px 10px; }

    .stage {
      position: relative; max-width: min(100%, 1100px); margin: 0 auto; background: #050505;
      border-radius: 8px; overflow: hidden; box-shadow: 0 0 0 1px #2a2a2a; user-select: none;
    }
    .stage > img { display: block; width: 100%; height: auto; }
    #top-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; display: none; }
    .stage.compare #top-img { display: block; }
    #cmp-slider { position: absolute; top: 0; bottom: 0; left: 50%; width: 40px; transform: translateX(-50%); cursor: ew-resize; z-index: 6; display: none; align-items: center; justify-content: center; touch-action: none; }
    .stage.compare #cmp-slider { display: flex; }
    #pair-color, #pair-bw { display: none; }
    #cmp-slider .line { position: absolute; top: 0; bottom: 0; left: 50%; width: 3px; transform: translateX(-50%); background: #fff; box-shadow: 0 0 4px rgba(0, 0, 0, .85); }
    #cmp-slider .handle { position: relative; z-index: 1; width: 36px; height: 36px; border-radius: 50%; background: #fff; color: #111; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; box-shadow: 0 0 7px rgba(0, 0, 0, .75); }

    .pair-controls { display: flex; gap: 8px; justify-content: center; margin: 12px 0; }
    .pc { padding: 7px 12px; border: 1px solid #3e5f9c; border-radius: 6px; color: #eaf0ff; background: #1d2b45; cursor: pointer; }
    .pc:hover { border-color: #88aaff; }
    .pc.active { background: #2f6df0; border-color: #88aaff; color: #fff; }

    .pair-pick { display: none; gap: 16px; justify-content: center; align-items: center; margin: 4px 0 12px; color: #bbd; font-size: .9rem; }
    .pair-pick.show { display: flex; }
    .pair-pick label { display: inline-flex; align-items: center; gap: 6px; }
    .pair-pick select { padding: 5px 8px; border: 1px solid #3e5f9c; border-radius: 6px; color: #eaf0ff; background: #1d2b45; cursor: pointer; }
    .pair-pick select:hover { border-color: #88aaff; }

    .info { display: flex; gap: 18px; align-items: center; justify-content: center; flex-wrap: wrap; margin: 16px 0; }
    .facts { display: flex; gap: 18px; flex-wrap: wrap; color: #bbb; font-size: .9rem; }
    .facts b { color: #6b86c0; font-weight: 600; }
    .orig-link { color: #88aaff; text-decoration: none; border: 1px solid #3e5f9c; border-radius: 6px; padding: 6px 12px; background: #1d2b45; }
    .orig-link:hover { border-color: #88aaff; }

    .people { max-width: 1100px; margin: 24px auto 0; }
    .people h2 { font-size: 1.05rem; color: #cde; margin-bottom: 8px; }
    .people ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
    .people a { color: #dbe6ff; text-decoration: none; border: 1px solid #3e5f9c; border-radius: 999px; padding: 4px 12px; background: #1d2b45; }
    .people a:hover { border-color: #88aaff; }

    /* Amber palette mirrors the object overlay so the two domains read as one. */
    .objects { max-width: 1100px; margin: 20px auto 0; }
    .objects h2 { font-size: 1.05rem; color: #ffce6e; margin-bottom: 8px; }
    .objects ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
    .obj-chip { display: inline-flex; align-items: baseline; gap: 8px; color: #ffd98a; border: 1px solid #6b531a; border-radius: 999px; padding: 4px 12px; background: #2a2008; text-decoration: none; }
    .obj-chip:hover { border-color: #ffb020; }
    .obj-chip .obj-name { font-weight: 600; }
    .obj-chip .obj-note { color: #bfae7e; font-size: .85rem; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  </style>

  {hasPair && (
    <script>
      const stage = document.getElementById('stage') as HTMLElement;
      const base = document.getElementById('base-img') as HTMLImageElement;
      const top = document.getElementById('top-img') as HTMLImageElement | null;
      const slider = document.getElementById('cmp-slider') as HTMLElement | null;
      const pick = document.getElementById('cmp-pick') as HTMLElement | null;
      const leftSel = document.getElementById('cmp-left') as HTMLSelectElement | null;
      const rightSel = document.getElementById('cmp-right') as HTMLSelectElement | null;
      // Read the *resolved* URLs from the hidden <img> sources (already made
      // page-relative by astro-relative-links), so they work over file:// too.
      const color = (document.getElementById('pair-color') as HTMLImageElement).src;
      const bw = (document.getElementById('pair-bw') as HTMLImageElement).src;
      // Comparison-group member URLs, indexed by their data-i (empty for a
      // simple two-image pair, which falls back to bw/color above).
      const memberSrcs: string[] = [];
      document.querySelectorAll('.cmp-src').forEach((el) => {
        memberSrcs[+(el as HTMLElement).dataset.i!] = (el as HTMLImageElement).src;
      });
      // The slider clips `top` from the right, so `top` is the LEFT side and
      // `base` is the RIGHT side of the divider.
      const leftSrc = () => (leftSel && memberSrcs.length) ? memberSrcs[+leftSel.value] : bw;
      const rightSrc = () => (rightSel && memberSrcs.length) ? memberSrcs[+rightSel.value] : color;
      let split = 50;

      function setSplit(pct: number) {
        split = Math.max(0, Math.min(100, pct));
        if (top) top.style.clipPath = `inset(0 ${(100 - split).toFixed(2)}% 0 0)`;
        if (slider) slider.style.left = `${split.toFixed(2)}%`;
      }
      function setMode(mode: string) {
        document.querySelectorAll('.pc').forEach((b) =>
          b.classList.toggle('active', (b as HTMLElement).dataset.mode === mode)
        );
        if (mode === 'compare') {
          stage.classList.add('compare');
          base.src = rightSrc();
          if (top) top.src = leftSrc();
          if (pick) pick.classList.add('show');
          setSplit(50);
        } else {
          stage.classList.remove('compare');
          if (pick) pick.classList.remove('show');
          base.src = mode === 'bw' ? bw : rightSrc();
        }
      }
      document.querySelectorAll('.pc').forEach((b) =>
        b.addEventListener('click', () => setMode((b as HTMLElement).dataset.mode!))
      );
      function onPickChange() {
        if (!stage.classList.contains('compare')) return;
        base.src = rightSrc();
        if (top) top.src = leftSrc();
      }
      leftSel?.addEventListener('change', onPickChange);
      rightSel?.addEventListener('change', onPickChange);

      let dragging = false;
      function pct(e: PointerEvent) {
        const r = stage.getBoundingClientRect();
        return r.width ? ((e.clientX - r.left) / r.width) * 100 : split;
      }
      stage.addEventListener('pointerdown', (e) => {
        if (!stage.classList.contains('compare')) return;
        dragging = true; setSplit(pct(e)); e.preventDefault();
      });
      window.addEventListener('pointermove', (e) => { if (dragging) setSplit(pct(e)); });
      window.addEventListener('pointerup', () => { dragging = false; });
    </script>
  )}
</Layout>
