---
import type { Person } from '../lib/data';
import { link } from '../lib/links';
interface Props { person: Person; }
const { person } = Astro.props;
const href = link(`/persons/${person.id}/`);
const life = [person.birthYear, person.deathYear].some(Boolean)
  ? `${person.birthYear || ''}–${person.deathYear || ''}`
  : '';
const displayThumb = person.thumb || (person.faceThumbs && person.faceThumbs[0]) || null;
const displayW = person.thumb ? (person.thumbW || undefined) : undefined;
const displayH = person.thumb ? (person.thumbH || undefined) : undefined;
---
<a class="card" href={href}>
  <div class="thumb-wrap">
    {displayThumb ? (
      <img
        src={displayThumb}
        alt={person.name}
        width={displayW}
        height={displayH}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="placeholder">👤</span>
    )}
  </div>
  <div class="body">
    <div class="title">{person.name || '(névtelen)'}</div>
    <div class="sub">
      {person.imageCount} kép{life ? ` · ${life}` : ''}
    </div>
  </div>
</a>
