---
import { loadManifest } from '../lib/data';
import { link } from '../lib/links';
import SearchBox from '../components/SearchBox.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  active?: string;
  /** Show the search box in the header (default true). */
  search?: boolean;
}

const { title, active = '', search = true } = Astro.props;
const manifest = loadManifest();
const pageTitle = title ? `${title} – ${manifest.title}` : manifest.title;

// Compute relative path to login.html from this page's route.
// Astro.url.pathname is e.g. "/persons/page/1/" — depth = 3 → "../../../login.html"
// Works on both http:// (server) and file:// (double-click).
const _depth = Astro.url.pathname.split('/').filter(Boolean).length;
const loginPath = '../'.repeat(_depth) + 'login.html';
const authToken = manifest.hasAuth ? manifest.authToken : '';
// Server auth = hasAuth true but no static token (Docker / local server mode).
const serverAuth = manifest.hasAuth && !manifest.authToken;
---

<!DOCTYPE html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {manifest.hasAuth && !serverAuth && (
      <script is:inline define:vars={{ authToken, loginPath }}>
        if (localStorage.getItem('fg_tok') !== authToken) {
          window.location.replace(loginPath);
        }
      </script>
    )}
    <title>{pageTitle}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  </head>
  <body>
    <header>
      <a class="brand" href={link('/')}>{manifest.title}</a>
      <Nav active={active} />
      {search && <SearchBox />}
      {serverAuth && (
        <button class="logout-btn" id="logoutBtn">Kilépés</button>
        <script is:inline>
          document.getElementById('logoutBtn').addEventListener('click', function() {
            fetch('/api/logout', { method: 'POST' })
              .finally(function() { window.location.href = '/login'; });
          });
        </script>
      )}
    </header>
    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <span class="footer-author">
          Készítette: <strong>Koncsik Benedek</strong>
          {manifest.appVersion && <span class="footer-ver">v{manifest.appVersion}</span>}
        </span>
        {manifest.generatedAt && (
          <span class="footer-generated">
            Exportálva: {new Date(manifest.generatedAt).toLocaleString('hu-HU', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Budapest' })}
          </span>
        )}
        <span class="footer-links">
          <a href="https://x.com/BenedekKoncsik" target="_blank" rel="noopener" title="X (Twitter)">
            <svg class="fi" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://github.com/BenKoncsik" target="_blank" rel="noopener" title="GitHub profil">
            <svg class="fi" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
          </a>
          <a href="https://github.com/HunKonTech" target="_blank" rel="noopener" title="GitHub szervezet">
            <svg class="fi" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
            <span class="fi-label">HunKonTech</span>
          </a>
          <a href="https://github.com/HunKonTech/local_ai_face_recognizer" target="_blank" rel="noopener" title="Projekt GitHub">
            <svg class="fi" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8Z"/></svg>
            <span class="fi-label">Repo</span>
          </a>
          <a href="https://github.com/HunKonTech/local_ai_face_recognizer/releases" target="_blank" rel="noopener" title="Kiadások">
            <svg class="fi" viewBox="0 0 16 16" fill="currentColor"><path d="M1 7.775V2.75C1 1.784 1.784 1 2.75 1h5.025c.464 0 .91.184 1.238.513l6.25 6.25a1.75 1.75 0 0 1 0 2.474l-5.026 5.026a1.75 1.75 0 0 1-2.474 0l-6.25-6.25A1.752 1.752 0 0 1 1 7.775Zm1.5 0c0 .066.026.13.073.177l6.25 6.25a.25.25 0 0 0 .354 0l5.025-5.025a.25.25 0 0 0 0-.354l-6.25-6.25a.25.25 0 0 0-.177-.073H2.75a.25.25 0 0 0-.25.25ZM6 5a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>
            <span class="fi-label">Releases</span>
          </a>
        </span>
      </div>
    </footer>

    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #111; color: #ddd; font-family: system-ui, sans-serif; min-height: 100vh; display: flex; flex-direction: column; }
      a { color: inherit; }
      button, input { font: inherit; }
      header {
        background: #1a1a1a; padding: 14px 20px; border-bottom: 1px solid #333;
        display: flex; align-items: center; gap: 14px; flex-wrap: wrap; position: relative; z-index: 20;
      }
      .brand { font-size: 1.15rem; color: #88aaff; font-weight: 700; text-decoration: none; white-space: nowrap; }
      header nav { display: flex; gap: 8px; flex-wrap: wrap; }
      .nav-link {
        color: #dbe6ff; text-decoration: none; border: 1px solid #3e5f9c; border-radius: 6px;
        padding: 6px 10px; background: #1d2b45; white-space: nowrap; font-size: .9rem;
      }
      .nav-link:hover, .nav-link:focus { border-color: #88aaff; background: #26385a; outline: none; }
      .nav-link.active { background: #2f6df0; border-color: #88aaff; color: #fff; }
      .logout-btn {
        margin-left: auto; padding: 6px 12px; border-radius: 6px;
        border: 1px solid #7a3a3a; background: #3a1a1a; color: #cf8f8f;
        cursor: pointer; font-size: .85rem; white-space: nowrap; transition: background .15s, border-color .15s;
      }
      .logout-btn:hover { background: #5a1a1a; border-color: #cf6f6f; color: #ffaaaa; }

      main { padding: 20px; flex: 1; }

      /* Shared card grid */
      .card-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
      .card {
        background: #1c1c1c; border: 1px solid #333; border-radius: 8px; overflow: hidden;
        text-decoration: none; color: inherit; display: flex; flex-direction: column;
        transition: border-color .15s;
      }
      .card:hover, .card:focus { border-color: #88aaff; outline: none; }
      .card .thumb-wrap { background: #050505; aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; overflow: hidden; }
      .card img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .card .body { padding: 10px 12px; }
      .card .title { font-weight: 600; font-size: .95rem; color: #eee; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .card .sub { font-size: .78rem; color: #888; margin-top: 3px; }
      .placeholder { color: #555; font-size: 2rem; }

      .page-head { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 16px; }
      .page-head h1 { font-size: 1.3rem; color: #cde; }
      .page-head .muted { color: #888; font-size: .85rem; }

      /* Pagination */
      .pagination { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; justify-content: center; margin: 22px 0 6px; }
      .pagination a, .pagination span {
        min-width: 38px; text-align: center; padding: 7px 10px; border-radius: 6px;
        border: 1px solid #3e5f9c; background: #1d2b45; color: #dbe6ff; text-decoration: none; font-size: .9rem;
      }
      .pagination a:hover { border-color: #88aaff; background: #26385a; }
      .pagination .current { background: #2f6df0; border-color: #88aaff; color: #fff; }
      .pagination .disabled { opacity: .35; pointer-events: none; }
      .pagination .gap { border: none; background: none; }

      /* Footer */
      footer {
        border-top: 1px solid #2a2a2a;
        background: #141414;
        padding: 10px 20px;
        margin-top: auto;
      }
      .footer-inner {
        display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
        font-size: .78rem; color: #666;
        max-width: 1200px;
      }
      .footer-author { display: flex; align-items: center; gap: 6px; }
      .footer-author strong { color: #999; font-weight: 600; }
      .footer-ver {
        background: #1d2b45; color: #88aaff; border: 1px solid #3e5f9c;
        border-radius: 4px; padding: 1px 6px; font-size: .72rem; font-family: monospace;
      }
      .footer-generated { color: #555; font-size: .75rem; }
      .footer-links { display: flex; align-items: center; gap: 4px; }
      .footer-links a {
        display: inline-flex; align-items: center; gap: 4px;
        color: #555; text-decoration: none; padding: 4px 6px;
        border-radius: 5px; transition: color .15s, background .15s;
        font-size: .75rem;
      }
      .footer-links a:hover { color: #aac; background: #1e1e2e; }
      .fi { width: 15px; height: 15px; flex-shrink: 0; }
      .fi-label { font-size: .72rem; }
    </style>
  </body>
</html>
