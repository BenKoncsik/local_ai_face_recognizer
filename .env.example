# Face-Local — environment variable overrides
#
# Copy this file to `.env` (which is in .gitignore) and fill in the real
# values.  The application reads `.env` at startup and pushes the
# whitelisted variables into the process environment BEFORE any module
# that needs them is imported.
#
# Only the variable names listed in app/gdrive/dotenv_loader.py:_ALLOWED_VARS
# are picked up — everything else in this file is ignored as a courtesy
# against accidental leakage of unrelated secrets.

# ---------------------------------------------------------------------------
# Google Drive OAuth credentials (desktop app type)
# ---------------------------------------------------------------------------
# 1. Open https://console.cloud.google.com/apis/credentials
# 2. Create a Desktop OAuth client (or open the existing one).
# 3. Paste the values below.
#
# The CLIENT_ID is also bundled into the build as a fallback default; the
# CLIENT_SECRET is NEVER committed to source control for public repos.
FACE_LOCAL_GOOGLE_CLIENT_ID=695041722567-6troo6v3cmq28j7ccj1r5kds67mvvetd.apps.googleusercontent.com
FACE_LOCAL_GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE-ME

# ---------------------------------------------------------------------------
# Optional: override config.yaml discovery
# ---------------------------------------------------------------------------
# FACE_LOCAL_CONFIG=/absolute/path/to/your/config.yaml
